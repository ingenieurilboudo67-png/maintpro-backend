# Base de données PostgreSQL
DATABASE_URL=postgres://maintpro:maintpro@localhost:5432/maintpro

# Serveur
PORT=4000
NODE_ENV=development

# Sécurité
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS - domaines autorisés à appeler l'API (séparés par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
